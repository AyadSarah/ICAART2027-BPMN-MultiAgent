<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Procurement"
                  targetNamespace="http://example.com/bpmn">
  <bpmn:process id="Process_ProcurementSupplierSelection" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Procurement" name="Procurement Team">
        <bpmn:flowNodeRef>StartEvent_NeedIdentified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueRFP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EvaluateProposals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SiteVisitNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductSiteVisits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AgreementReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OnboardSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Onboarded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_NeedIdentified" name="Need for New Supplier Identified"/>
    <bpmn:task id="Task_IssueRFP" name="Issue RFP"/>
    <bpmn:task id="Task_ReceiveProposals" name="Receive Proposals"/>
    <bpmn:task id="Task_EvaluateProposals" name="Evaluate Proposals"/>
    <bpmn:exclusiveGateway id="Gateway_SiteVisitNeeded" name="Site Visit or Interview Needed?"/>
    <bpmn:task id="Task_ConductSiteVisits" name="Conduct Site Visits / Interviews"/>
    <bpmn:task id="Task_SelectSupplier" name="Select Supplier"/>
    <bpmn:task id="Task_NegotiateContract" name="Contract Negotiations"/>
    <bpmn:exclusiveGateway id="Gateway_AgreementReached" name="Agreement Reached?"/>
    <bpmn:task id="Task_SignContract" name="Sign Contract"/>
    <bpmn:task id="Task_OnboardSupplier" name="Onboard Supplier"/>
    <bpmn:endEvent id="EndEvent_Onboarded" name="Supplier Onboarded and Contract Executed"/>

    <bpmn:sequenceFlow id="Flow_Start_IssueRFP" sourceRef="StartEvent_NeedIdentified" targetRef="Task_IssueRFP"/>
    <bpmn:sequenceFlow id="Flow_IssueRFP_ReceiveProposals" sourceRef="Task_IssueRFP" targetRef="Task_ReceiveProposals"/>
    <bpmn:sequenceFlow id="Flow_ReceiveProposals_Evaluate" sourceRef="Task_ReceiveProposals" targetRef="Task_EvaluateProposals"/>
    <bpmn:sequenceFlow id="Flow_Evaluate_SiteVisitGateway" sourceRef="Task_EvaluateProposals" targetRef="Gateway_SiteVisitNeeded"/>
    <bpmn:sequenceFlow id="Flow_Gateway_To_SiteVisits" sourceRef="Gateway_SiteVisitNeeded" targetRef="Task_ConductSiteVisits"/>
    <bpmn:sequenceFlow id="Flow_SiteVisits_To_Select" sourceRef="Task_ConductSiteVisits" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_Gateway_To_Select" sourceRef="Gateway_SiteVisitNeeded" targetRef="Task_SelectSupplier"/>
    <bpmn:sequenceFlow id="Flow_Select_To_Negotiate" sourceRef="Task_SelectSupplier" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_Negotiate_To_Gateway" sourceRef="Task_NegotiateContract" targetRef="Gateway_AgreementReached"/>
    <bpmn:sequenceFlow id="Flow_Gateway_NoBack_To_Negotiate" sourceRef="Gateway_AgreementReached" targetRef="Task_NegotiateContract"/>
    <bpmn:sequenceFlow id="Flow_Gateway_To_Sign" sourceRef="Gateway_AgreementReached" targetRef="Task_SignContract"/>
    <bpmn:sequenceFlow id="Flow_Sign_To_Onboard" sourceRef="Task_SignContract" targetRef="Task_OnboardSupplier"/>
    <bpmn:sequenceFlow id="Flow_Onboard_To_End" sourceRef="Task_OnboardSupplier" targetRef="EndEvent_Onboarded"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Procurement">
    <bpmndi:BPMNPlane id="BPMNPlane_Procurement" bpmnElement="Process_ProcurementSupplierSelection">
      <!-- Lane shape -->
      <bpmndi:BPMNShape id="BPMNShape_Lane_Procurement" bpmnElement="Lane_Procurement">
        <dc:Bounds x="20" y="40" width="1740" height="140"/>
      </bpmndi:BPMNShape>

      <!-- Flow node shapes -->
      <bpmndi:BPMNShape id="BPMNShape_StartEvent_NeedIdentified" bpmnElement="StartEvent_NeedIdentified" isMarkerVisible="true">
        <dc:Bounds x="50" y="80" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_IssueRFP" bpmnElement="Task_IssueRFP">
        <dc:Bounds x="140" y="65" width="100" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_ReceiveProposals" bpmnElement="Task_ReceiveProposals">
        <dc:Bounds x="280" y="65" width="100" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_EvaluateProposals" bpmnElement="Task_EvaluateProposals">
        <dc:Bounds x="420" y="65" width="100" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Gateway_SiteVisitNeeded" bpmnElement="Gateway_SiteVisitNeeded">
        <dc:Bounds x="560" y="70" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_ConductSiteVisits" bpmnElement="Task_ConductSiteVisits">
        <dc:Bounds x="660" y="20" width="140" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_SelectSupplier" bpmnElement="Task_SelectSupplier">
        <dc:Bounds x="820" y="65" width="120" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_NegotiateContract" bpmnElement="Task_NegotiateContract">
        <dc:Bounds x="1020" y="65" width="120" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Gateway_AgreementReached" bpmnElement="Gateway_AgreementReached">
        <dc:Bounds x="1220" y="70" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_SignContract" bpmnElement="Task_SignContract">
        <dc:Bounds x="1320" y="65" width="120" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_Task_OnboardSupplier" bpmnElement="Task_OnboardSupplier">
        <dc:Bounds x="1500" y="65" width="120" height="60"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_EndEvent_Onboarded" bpmnElement="EndEvent_Onboarded">
        <dc:Bounds x="1680" y="80" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Sequence flow edges -->
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Start_IssueRFP" bpmnElement="Flow_Start_IssueRFP">
        <di:waypoint x="86" y="98"/>
        <di:waypoint x="140" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_IssueRFP_ReceiveProposals" bpmnElement="Flow_IssueRFP_ReceiveProposals">
        <di:waypoint x="240" y="95"/>
        <di:waypoint x="280" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ReceiveProposals_Evaluate" bpmnElement="Flow_ReceiveProposals_Evaluate">
        <di:waypoint x="380" y="95"/>
        <di:waypoint x="420" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Evaluate_SiteVisitGateway" bpmnElement="Flow_Evaluate_SiteVisitGateway">
        <di:waypoint x="520" y="95"/>
        <di:waypoint x="560" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gateway_To_SiteVisits" bpmnElement="Flow_Gateway_To_SiteVisits">
        <di:waypoint x="585" y="95"/>
        <di:waypoint x="660" y="50"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_SiteVisits_To_Select" bpmnElement="Flow_SiteVisits_To_Select">
        <di:waypoint x="790" y="50"/>
        <di:waypoint x="820" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gateway_To_Select" bpmnElement="Flow_Gateway_To_Select">
        <di:waypoint x="610" y="95"/>
        <di:waypoint x="820" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Select_To_Negotiate" bpmnElement="Flow_Select_To_Negotiate">
        <di:waypoint x="940" y="95"/>
        <di:waypoint x="1020" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Negotiate_To_Gateway" bpmnElement="Flow_Negotiate_To_Gateway">
        <di:waypoint x="1140" y="95"/>
        <di:waypoint x="1220" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gateway_NoBack_To_Negotiate" bpmnElement="Flow_Gateway_NoBack_To_Negotiate">
        <di:waypoint x="1245" y="95"/>
        <di:waypoint x="1080" y="125"/>
        <di:waypoint x="1140" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Gateway_To_Sign" bpmnElement="Flow_Gateway_To_Sign">
        <di:waypoint x="1280" y="95"/>
        <di:waypoint x="1320" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Sign_To_Onboard" bpmnElement="Flow_Sign_To_Onboard">
        <di:waypoint x="1440" y="95"/>
        <di:waypoint x="1500" y="95"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="BPMNEdge_Flow_Onboard_To_End" bpmnElement="Flow_Onboard_To_End">
        <di:waypoint x="1600" y="95"/>
        <di:waypoint x="1680" y="98"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>